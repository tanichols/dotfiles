# =============================================================================
# Brewfile
# Run: brew bundle
# Update: brew bundle --force (reinstalls everything)
# Audit: brew bundle check (shows what's missing)
# =============================================================================

# =============================================================================
# CLI Tools
# =============================================================================
brew "git"                          # newer than macOS built-in
brew "jq"                           # JSON parsing in the terminal
brew "htop"                         # interactive process viewer
brew "watch"                        # run commands repeatedly
brew "wget"                         # HTTP downloads
brew "rsync"                        # file sync (newer than macOS built-in)
brew "tree"                         # directory listings as a tree
brew "tmux"                         # terminal multiplexer — useful for server SSH sessions
brew "openssh"                      # newer SSH client
brew "nmap"                         # network scanning
# brew "dnsutils"                     # dig, nslookup — DNS debugging

# =============================================================================
# Shell & Terminal
# =============================================================================
brew "zsh-autosuggestions"          # fish-like inline suggestions
brew "zsh-syntax-highlighting"      # command syntax highlighting
brew "powerlevel10k"                # prompt theme — sourced in .zshrc

# =============================================================================
# Development
# =============================================================================
brew "nvm"                          # Node version manager (use instead of raw node if preferred)

# =============================================================================
# AWS
# =============================================================================
# brew "awscli"                       # AWS CLI for S3/Glacier management

# =============================================================================
# Casks (GUI Applications)
# =============================================================================
cask "iterm2"                       # terminal emulator
cask "visual-studio-code"           # code editor
cask "docker"                       # Docker Desktop
cask "bitwarden"                    # password manager
cask "rectangle"                    # window management (move/resize with keyboard)
cask "font-fira-code-nerd-font"     # popular alternative with ligatures

# =============================================================================
# Mac App Store (requires: brew install mas)
# =============================================================================
# brew "mas"
# mas "Amphetamine", id: 937984704  # keep Mac awake — useful during long server tasks
