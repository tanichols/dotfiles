# =============================================================================
# .extra — local overrides and secrets
# This file is NOT committed to the repo (.gitignore'd)
# Copy this template to ~/.extra and fill in your values
# =============================================================================

# Git identity — required
GIT_AUTHOR_NAME="Your Name"
GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
git config --global user.name "$GIT_AUTHOR_NAME"

GIT_AUTHOR_EMAIL="your@email.com"
GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
git config --global user.email "$GIT_AUTHOR_EMAIL"

# SSH aliases for homelab — uncomment and fill in when servers are up
# alias nas="ssh admin@nas.local"
# alias server="ssh thomas@server.local"

# Any machine-specific PATH additions or overrides
# export PATH="$HOME/some/local/bin:$PATH"
