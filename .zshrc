# =============================================================================
# .zshrc
# =============================================================================

# Enable Powerlevel10k instant prompt. Must stay near the top of ~/.zshrc.
# Console input (password prompts, [y/n] confirmations) must go above this block.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to Oh My Zsh installation
export ZSH="$HOME/.oh-my-zsh"

# =============================================================================
# Theme — Powerlevel10k
# Loaded directly from Homebrew after Oh My Zsh is sourced (see below).
# Run `p10k configure` to regenerate ~/.p10k.zsh interactively.
# =============================================================================
ZSH_THEME=""

# =============================================================================
# Plugins
# zsh-autosuggestions and zsh-syntax-highlighting are installed via Homebrew
# and sourced below — they do NOT go in this plugins array.
# =============================================================================
plugins=(
  git
  docker
  docker-compose
)

source $ZSH/oh-my-zsh.sh

# =============================================================================
# Powerlevel10k (loaded directly from Homebrew)
# =============================================================================
[[ -f /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme ]] && \
  source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme

# =============================================================================
# Homebrew-installed plugins (must come after Oh My Zsh is sourced)
# =============================================================================
[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && \
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && \
  source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# =============================================================================
# Source config files
# =============================================================================
[ -f ~/.exports   ] && source ~/.exports
[ -f ~/.aliases   ] && source ~/.aliases
[ -f ~/.functions ] && source ~/.functions
[ -f ~/.extra     ] && source ~/.extra   # local overrides, never committed

# =============================================================================
# Powerlevel10k config (generated by `p10k configure`)
# =============================================================================
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
