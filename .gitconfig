# =============================================================================
# .gitconfig
# Note: name and email should go in ~/.extra, not here, to keep this
# file safely committable to a public repo.
# =============================================================================

[core]
	excludesfile = /Users/tanichols/.gitignore_global
  editor = code --wait
  autocrlf = input                  # normalize line endings on commit

[pull]
  rebase = false                    # merge by default on pull

[push]
  default = current                 # push current branch to same-named remote

[init]
  defaultBranch = main

[color]
  ui = auto

[alias]
  st = status
  co = checkout
  br = branch
  lg = log --oneline --graph --decorate --all
  undo = reset --soft HEAD~1        # undo last commit, keep changes staged
  aliases = config --get-regexp alias
